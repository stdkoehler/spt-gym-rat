{
  // Turn the whole mod off without uninstalling it.
  "enabled": true,

  // Minutes until the gym resets after a workout (how long muscle pain lasts).
  // Range: 1 to 10080 (one week).
  //   1440 = vanilla (24 hours)
  //     60 = 1 hour
  //     10 = 10 minutes
  "gymResetMinutes": 1440,

  // Consuming one of these items in the hideout resets the gym immediately
  // (removes muscle pain).
  // NOTE:
  // - Deactivated by default (empty list). Only active combat recovery and Hideout crafts are active.
  // - Only consumable food and drink items (handled via the Eat/Drink route) are supported.
  // Example enabling Norvinsky Premium kvass:
  //   "resetItems": [
  //     "5e8f3423fd7471236e6e3b64" // Norvinsky Premium kvass
  //   ],
  "resetItems": [],

  // true  = only items found in raid (FIR) trigger the reset
  // false = any copy of the item works
  "requireFoundInRaid": true,

  // Active recovery: reset gym cooldown by performing combat feats in raids.
  "activeRecoveryEnabled": true,

  // true = killing a scav boss (or Rogue boss) clears gym muscle pain
  "bossKillResets": true,

  // Minimum PMC kills in a single raid to clear gym muscle pain (0 = disabled)
  "minPmcKillsForReset": 5,

  // true = player must survive/transit the raid for active recovery to trigger
  "requireSurviveForActiveRecovery": true,

  // true = Therapist sends an in-game message confirming the muscle pain was cleared
  "notifyOnActiveRecovery": true,

  // Hideout recovery crafts: earn workout resets or cooldown reductions via the Hideout.
  "hideoutCraftsEnabled": true,

  // Recovery Shower craft (Lavatory): completely resets workout muscle pain on "Get Items".
  "showerCraftMinutes": 30,
  "showerLavatoryLevel": 3,
  "showerRequireFir": true,
  "showerIngredients": [
    "5c13cd2486f774072c757944", // Soap
    "5d40412b86f7743cb332ac3a", // Shampoo
    "5d1b33a686f7742523398398", // Canister with purified water (superwater)
    "5e2af47786f7746d404f3aaa"  // Fleece fabric
  ],
  "showerEndProduct": "5e2af47786f7746d404f3aaa", // Fleece fabric

  // Nutrition Regime craft (Nutrition Unit): reduces remaining muscle pain cooldown by factor (e.g. 6 = /6).
  "nutritionCraftMinutes": 15,
  "nutritionUnitLevel": 1,
  "nutritionReductionFactor": 6.0,
  "nutritionRequireFir": true,
  "nutritionIngredients": [
    "5751496424597720a27126da", // Can of Hot Rod energy
    "62a0a043cf4a99369e2624a5", // Bottle of OLOLO multivitamins
    "57347d7224597744596b4e72", // Can of beef stew (small)
    "56742c2e4bdc2d95058b456d"  // Zibbo lighter
  ],
  "nutritionEndProduct": "56742c2e4bdc2d95058b456d" // Zibbo lighter
}
