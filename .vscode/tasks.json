{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build",
      "command": "dotnet",
      "type": "process",
      "args": [
        "build",
        "${workspaceFolder}/spt-flexi-gym.sln",
        "/property:GenerateFullPaths=true",
        "/consoleloggerparameters:NoSummary;ForceNoAlign"
      ],
      "problemMatcher": "$msCompile",
      "group": { "kind": "build", "isDefault": true }
    },
    {
      "label": "build-mod",
      "command": "dotnet",
      "type": "process",
      "args": [
        "build",
        "${workspaceFolder}/src/FlexiGym/FlexiGym.csproj",
        "/property:GenerateFullPaths=true",
        "/consoleloggerparameters:NoSummary;ForceNoAlign"
      ],
      "problemMatcher": "$msCompile"
    },
    {
      "label": "build-mod-release",
      "command": "dotnet",
      "type": "process",
      "args": [
        "build",
        "-c",
        "Release",
        "${workspaceFolder}/src/FlexiGym/FlexiGym.csproj",
        "/property:GenerateFullPaths=true",
        "/consoleloggerparameters:NoSummary;ForceNoAlign"
      ],
      "problemMatcher": "$msCompile"
    },
    {
      "label": "build-test",
      "command": "dotnet",
      "type": "process",
      "args": [
        "build",
        "${workspaceFolder}/tests/FlexiGym.Tests/FlexiGym.Tests.csproj",
        "/property:GenerateFullPaths=true",
        "/consoleloggerparameters:NoSummary;ForceNoAlign"
      ],
      "problemMatcher": "$msCompile"
    },
    {
      "label": "run-test",
      "command": "dotnet",
      "type": "process",
      "args": ["run"],
      "options": { "cwd": "${workspaceFolder}/tests/FlexiGym.Tests" },
      "problemMatcher": "$msCompile"
    },
    {
      "label": "package-mod",
      "command": "bash",
      "type": "process",
      "args": ["${workspaceFolder}/src/FlexiGym/package.sh"],
      "problemMatcher": []
    },
    {
      "label": "clean",
      "command": "dotnet",
      "type": "process",
      "args": ["clean", "${workspaceFolder}/spt-flexi-gym.sln"],
      "problemMatcher": "$msCompile"
    }
  ]
}
