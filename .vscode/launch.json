{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug: Tests",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build-test",
      "program": "${workspaceFolder}/tests/GymRat.Tests/bin/Debug/net10.0/GymRat.Tests.dll",
      "args": [],
      "cwd": "${workspaceFolder}/tests/GymRat.Tests",
      "console": "internalConsole",
      "stopAtEntry": false
    },
    {
      "name": "Attach: Pick Process (SPT.Server)",
      "type": "coreclr",
      "request": "attach",
      "processId": "${command:pickProcess}"
    }
  ]
}
